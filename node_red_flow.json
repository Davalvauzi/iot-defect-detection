    "name": "Simulasi Barang Cacat (DEFECT)",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"id\":\"QC-102\",\"status\":\"DEFECT\",\"irVal\":850,\"defectType\":\"Goresan Permukaan\",\"action\":\"Reject\"}",
    "payloadType": "json",
