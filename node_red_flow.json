        "function_process_qc"
      ]
    ]
  },
  {
    "id": "function_process_qc",
    "type": "function",
    "z": "tab_qc_iot",
    "name": "Proses Evaluasi QC & Routing",
    "func": "let data = msg.payload;\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch(e) {}\n}\n\nlet total = context.get('total') || 0;\nlet pass = context.get('pass') || 0;\nlet defect = context.get('defect') || 0;\n\ntotal += 1;\nif (data.status === 'PASS') {\n    pass += 1;\n} else {\n    defect += 1;\n}\n\ncontext.set('total', total);\ncontext.set('pass', pass);\ncontext.set('defect', defect);\n\nlet msgMetric = { payload: { total: total, pass: pass, defect: defect } };\nlet msgChart = { payload: data.irVal !== undefined ? data.irVal : (data.status === 'PASS' ? 140 : 850), topic: data.id || 'Unit' };\nlet msgAlert = null;\n\nif (data.status === 'DEFECT') {\n    msgAlert = { payload: '⚠️ PERINGATAN: Barang Cacat Terdeteksi (' + (data.defectType || 'Reject') + ') pada #' + (data.id || 'N/A') };\n}\n\nreturn [msgMetric, msgChart, msgAlert, { payload: data }];",
    "outputs": 4,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 480,
    "y": 220,
    "wires": [
      [
        "ui_text_metrics",
        "debug_log"
      ],
      [
        "ui_chart_trend"
      ],
      [
        "ui_notification_alert"
      ],
      [
        "ui_template_table"
      ]
    ]
  },
